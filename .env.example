# ================================
# 2Subscribe Frontend Environment
# ================================
# NOTE:
# - All VITE_* values are exposed to the client bundle.
# - Do not place private backend secrets here.

# Backend API URL (Node backend repo, deployed separately)
# Example: https://subscribebackend-production-6076e.up.railway.app/api
VITE_BACKEND_API_URL=https://subscribebackend-production-6076e.up.railway.app/api

# Data backend mode
# Options: MOCK | FIREBASE
VITE_DATA_BACKEND=FIREBASE

# Firebase web app configuration (client-safe, required in FIREBASE mode)
VITE_FIREBASE_API_KEY=replace_with_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_project_id
VITE_FIREBASE_STORAGE_BUCKET=replace_with_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
VITE_FIREBASE_APP_ID=replace_with_app_id
VITE_FIREBASE_MEASUREMENT_ID=replace_with_measurement_id

# RevenueCat public SDK key (client-safe app key, not private REST secret)
VITE_REVENUECAT_API_KEY=replace_with_revenuecat_public_sdk_key

# Plaid/Bank integration flags (frontend behavior only — no secrets)
# VITE_PLAID_CLIENT_ID and VITE_PLAID_SECRET must NEVER appear here.
# Plaid credentials are backend-only (see 2subscribe-backend/.env.example).
VITE_USE_PLAID_BACKEND=true
VITE_PLAID_ENV=sandbox

# Auth/feature flags
VITE_REQUIRE_EMAIL_VERIFICATION=true
VITE_APP_VERSION=local-dev
